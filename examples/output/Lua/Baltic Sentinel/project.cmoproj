    "author": "CMO Scenario Studio example",
    "inspired_by": "",
    "setting": "Gulf of Finland",
    "location": "Gulf of Finland and the Estonian coast",
    "db_file": "DB3K_519.db3",
    "complexity": 2,
    "difficulty": 3,
    "hypothetical_note": "This is a hypothetical scenario made to demonstrate CMO Scenario Studio.",
    "description_html": "<P>Tension in the Gulf of Finland has been rising for weeks. A Russian surface action group has sailed from Kronstadt, and Russian aircraft are probing Finnish and Estonian airspace.</P>\n\n<P>NATO commands a Finnish and Estonian force under Allied air cover. Russia must show the flag, test the Alliance's air defences and, if ordered, seize the island of Hogland (Suursaari).</P>",
    "auto_header": true,
    "designer_notes": ""
  },
  "clock": {
    "start": "2030-05-12T04:00:00",
    "duration_days": 0,
    "duration_hours": 12,
    "duration_minutes": 0
  },
  "weather": {
    "temperature": 9.0,
    "rainfall": 0,
    "cloud": 0.3,
    "sea_state": 2
  },
  "build": {
    "armed_start": true,
    "default_loadout": 3,

      "description": "Show the score.",
      "repeatable": true,
      "active": true,
      "script": "BS_Sitrep('NATO')"
    },
    {
      "id": "sa_fb4f3ef2",
      "side": "s_2bea36ad",
      "name": "SITREP",
      "description": "Show the score.",
      "repeatable": true,
      "active": true,
      "script": "BS_Sitrep('Russia')"
    }
  ],
  "scripts": [
    {
      "id": "lua_17aea8db",
      "name": "Helpers",
      "content": "-- Helpers.lua - loaded when the scenario loads (shared functions for events).\nfunction BS_Sitrep(side)\n  local text = string.format('<P><B>SITREP</B></P><P>NATO score: %d<BR>Russia score: %d</P>',\n    StudioScore('NATO'), StudioScore('Russia'))\n  StudioMsg(side, text)\nend\n",
      "load_on_init": true,
      "notes": "Shared functions, loaded with LuaInit"
    },
    {
      "id": "lua_4549a4e4",
      "name": "Tick",
      "content": "-- Tick.lua - runs every minute (event 'Clock Tick').\n-- Blue scores a point for every 30 minutes Hogland island stays out of Red hands.\nlocal last = StudioGetNumKV('BS_LAST_HOLD', STUDIO.START)\nlocal now = tonumber(ScenEdit_CurrentTime()) or 0\nif now - last >= 1800 then\n  StudioSetKV('BS_LAST_HOLD', now)\n  if not StudioFlag('BS_HOGLAND_LOST') then\n    StudioAddScore('NATO', 1, 'Hogland held')\n  end\nend\n",
      "load_on_init": false,
      "notes": "Runs every minute"
    }
  ],
